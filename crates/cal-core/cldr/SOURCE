# The Unicode CLDR file the Windows zone table is generated from, pinned.
#
# `cargo xtask windows-zones` reads this file, checks windowsZones.xml against
# sha256 (reading CRLF as LF), and writes the release into the generated table,
# crates/cal-core/src/windows_zone/table.rs. The XML's own version
# attributes (typeVersion="2021a", otherVersion="7e11800") were never updated
# upstream, so the release tag is the version. The file's last data change is
# CLDR commit c4bb2c199c (2026-10-09, "CLDR-19827 Update Windows zones"): it
# adds British Columbia, Alberta and Manitoba Standard Time for the Canadian
# zones that stopped changing their clocks in 2026 (tzdata 2026b-2026e).
#
# The clock guard compares every zone with its Windows zone for five years from
# `published`.
#
# Never edit windowsZones.xml by hand. To update: take windowsZones.xml and
# LICENSE from one CLDR release tag, write that tag, its publication date, both
# URLs and the XML's sha256 here, run `cargo xtask windows-zones`, and commit
# all of it together.

release = release-49
published = 2026-10-21
url = https://raw.githubusercontent.com/unicode-org/cldr/release-49/common/supplemental/windowsZones.xml
licence = https://raw.githubusercontent.com/unicode-org/cldr/release-49/LICENSE
sha256 = 5f902f94106a396cb7774f0b0e1ca4dfecb686494045350c0b4935d378e3913b
