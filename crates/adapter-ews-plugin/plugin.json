  "account": {
    "fields": [
      {
        "key": "endpoint",
        "kind": "url",
        "label": "EWS endpoint URL",
        "label_key": "account.endpoint.label",
        "hint_key": "account.endpoint.hint",
        "required": true
      },
      {
        "key": "username",
        "kind": "text",
        "label": "Username",
        "label_key": "account.username.label",
        "hint_key": "account.username.hint",
        "required": true
      },
      {
        "key": "password",
        "kind": "secret",
        "secret_slot": "password",
        "label": "Password",
        "label_key": "account.password.label",
        "hint_key": "account.password.hint",
        "required": true
      }
    ],
    "actions": [
      {
        "key": "discover",
        "entry": "discover",
        "label": "Discover URL",
        "label_key": "account.action.discover.label",
        "busy_label_key": "account.action.discover.busy",
        "success_key": "account.action.discover.ok",
        "hint_key": "account.action.discover.hint",
        "requires": [
          {
            "field": "username",
            "message": "Enter your e-mail address first.",
            "message_key": "account.action.discover.needs_email"
          },
          {
            "field": "password",
            "message": "Enter your password first.",
            "message_key": "account.action.discover.needs_password"
          }
        ],
        "inputs": {
          "email": "username",
          "password": "password"
        },
        "fills": {
          "endpoint": "ews_url",
          "username": "account_email"
        }
      }
    ],
    "state_dir_field": "state_dir"
  },
  "strings": {
    "en": {
      "account.action.discover.busy": "Discovering …",
      "account.action.discover.hint": "Ask Microsoft Autodiscover for the EWS endpoint based on your e-mail address. Requires the e-mail and password fields above to be filled in.",
      "account.action.discover.label": "Discover URL",
      "account.action.discover.needs_email": "Please enter your e-mail address before running Discover — autodiscover uses it to figure out which server to ask.",
      "account.action.discover.needs_password": "Please enter your password before running Discover — Microsoft's autodiscover endpoint requires Basic auth.",
      "account.action.discover.ok": "Autodiscover found the endpoint.",
      "account.endpoint.hint": "The Exchange Web Services SOAP endpoint your server admin gave you. Always ends in \"/EWS/Exchange.asmx\". If you don't know the URL, fill in the e-mail + password fields below and press \"Discover URL\" — Aperio will ask Microsoft Autodiscover for you.",
      "account.endpoint.label": "EWS endpoint URL",
      "account.password.hint": "The password of your Exchange mailbox. EWS authenticates with HTTP Basic on every request; the password is stored only in your operating system's credential store.",
      "account.password.label": "Password",
      "account.username.hint": "Usually your full email address, but some servers want DOMAIN\\username. Ask your admin if unsure.",
      "account.username.label": "Username",
      "kind.ews.name": "Exchange on-premise (EWS)",
      "kind.ews.short": "Exchange (EWS)"
    },
    "de": {
      "account.action.discover.busy": "Suche …",
      "account.action.discover.hint": "Microsoft Autodiscover anhand der E-Mail-Adresse nach der EWS-Endpunkt-URL fragen. Setzt voraus, dass E-Mail und Passwort oben ausgefüllt sind.",
      "account.action.discover.label": "URL automatisch suchen",
      "account.action.discover.needs_email": "Bitte zuerst die E-Mail-Adresse eintragen — Autodiscover braucht sie, um den richtigen Server zu finden.",
      "account.action.discover.needs_password": "Bitte zuerst das Passwort eintragen — der Autodiscover-Endpunkt fordert Basic-Auth.",
      "account.action.discover.ok": "Autodiscover hat die Endpunkt-URL gefunden.",
      "account.endpoint.hint": "Die SOAP-URL der Exchange Web Services, die dein Admin dir genannt hat. Endet immer auf „/EWS/Exchange.asmx\". Wenn du die URL nicht kennst: trage E-Mail und Passwort unten ein und drücke „URL automatisch suchen\" — Aperio fragt für dich bei Microsoft Autodiscover nach.",
      "account.endpoint.label": "EWS-Endpunkt-URL",
      "account.password.hint": "Das Passwort deines Exchange-Postfachs. EWS meldet sich bei jeder Anfrage per HTTP-Basic an; das Passwort wird nur im Anmeldeinformations-Manager des Betriebssystems gespeichert.",
      "account.password.label": "Passwort",
      "account.username.hint": "Meist deine vollständige E-Mail-Adresse, manche Server wollen aber DOMAIN\\Benutzername. Bei Unsicherheit den Admin fragen.",
      "account.username.label": "Benutzername",
      "kind.ews.name": "Exchange On-Premise (EWS)",
      "kind.ews.short": "Exchange (EWS)"
    }
  }
