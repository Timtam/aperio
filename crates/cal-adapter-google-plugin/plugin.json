{
  "id": "com.aperio.cal-adapter-google",
  "name": "Aperio Google",
  "version": "0.1.0",
  "plugin_type": "calendar-adapter",
  "capabilities": ["calendar", "tasks", "contacts"],
  "abi_version": 2,
  "min_app_version": "0.1.0",
  "author": "Aperio Contributors",
  "description": "Bundled adapter for Google Calendar, Google Tasks and Google People (Contacts).",
  "adapter_kind": "google",
  "signed": false,
  "tasks": {
    "subtasks": true,
    "max_subtask_depth": 1,
    "task_recurrence": false,
    "supports_in_progress": false,
    "create_lists": true,
    "delete_lists": true
  }
}
