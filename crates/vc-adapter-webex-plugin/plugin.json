{
  "id": "com.aperio.vc-adapter-webex",
  "name": "Aperio Cisco WebEx",
  "version": "0.1.0",
  "plugin_type": "videoconference-adapter",
  "abi_version": 3,
  "min_app_version": "0.1.0",
  "author": "Aperio Contributors",
  "description": "Generate Cisco WebEx meeting links via the WebEx Meetings REST API. Uses a separate WebEx OAuth flow per account.",
  "adapter_kind": "webex",
  "signed": false,
  "account": {
    "fields": [
      {
        "key": "client_id",
        "kind": "text",
        "label": "Client ID",
        "label_key": "dialogs.accounts.webexClientIdLabel",
        "hint_key": "dialogs.accounts.webexClientIdHint",
        "required": true
      },
      {
        "key": "client_secret",
        "kind": "secret",
        "secret_slot": "oauth_client_secret",
        "label": "Client secret",
        "label_key": "dialogs.accounts.webexClientSecretLabel",
        "hint_key": "dialogs.accounts.webexClientSecretHint",
        "required": true
      },
      {
        "key": "site_url",
        "kind": "text",
        "label": "Webex site",
        "label_key": "dialogs.accounts.webexSiteLabel",
        "hint_key": "dialogs.accounts.webexSiteHint",
        "required": false
      }
    ],
    "oauth": {
      "builtin_provider": "webex",
      "client_id_field": "client_id",
      "client_secret_field": "client_secret",
      "refresh_token_field": "refresh_token"
    },
    "host_channel": true
  },
  "strings": {
    "en": {
      "join.link": "Join the meeting",
      "join.number": "Meeting number (access code)",
      "join.password": "Meeting password",
      "join.password.phone": "Password for phones and video systems",
      "join.phone": "Join by phone",
      "join.phone.more": "Global call-in numbers",
      "join.video": "Join from a video system or application"
    },
    "de": {
      "join.link": "Meeting beitreten",
      "join.number": "Meeting-Kennnummer (Zugriffscode)",
      "join.password": "Meeting-Passwort",
      "join.password.phone": "Passwort für Telefon- und Videosysteme",
      "join.phone": "Über Telefon beitreten",
      "join.phone.more": "Globale Einwahlnummern",
      "join.video": "Über Videogerät oder -anwendung beitreten"
    }
  }
}
