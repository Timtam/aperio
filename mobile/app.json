{
  "expo": {
    "name": "Aperio",
    "slug": "aperio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "aperio",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "appleTeamId": "X3TAD26JBY",
      "bundleIdentifier": "com.aperio.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": ["fetch"],
        "BGTaskSchedulerPermittedIdentifiers": ["com.aperio.mobile.refresh"],
        "NSCalendarsUsageDescription": "Aperio shows and edits the events in your device calendars alongside your other accounts.",
        "NSCalendarsFullAccessUsageDescription": "Aperio shows and edits the events in your device calendars alongside your other accounts.",
        "NSRemindersUsageDescription": "Aperio shows and edits your Reminders lists as tasks alongside your other accounts.",
        "NSRemindersFullAccessUsageDescription": "Aperio shows and edits your Reminders lists as tasks alongside your other accounts."
      }
    },
    "android": {
      "package": "com.aperio.mobile",
      "allowBackup": false,
      "permissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.USE_EXACT_ALARM"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.CAMERA"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "56442678-7da3-4046-96e3-d2da1e17c487",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "AperioWidgets",
                  "bundleIdentifier": "com.aperio.mobile.widget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.aperio.mobile"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    },
    "owner": "tonirbarth",
    "plugins": [
      "./plugins/withoutPushEntitlement",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#E6F4FE",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#11151c"
          }
        }
      ],
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#1d4ed8"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Aperio accesses your photo library so you can set a contact's photo.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "./plugins/withReminderSoundProvider",
      "./plugins/withAppGroup",
      "./plugins/withAppShortcuts",
      "./plugins/withAndroidAbis",
      [
        "expo-localization",
        {
          "supportedLocales": ["en", "de"]
        }
      ],
      "react-native-bottom-tabs",
      "expo-background-task",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow $(PRODUCT_NAME) to unlock the app with Face ID."
        }
      ],
      "@bacons/apple-targets"
    ]
  }
}
